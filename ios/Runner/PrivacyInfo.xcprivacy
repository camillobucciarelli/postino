<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Postino's privacy manifest (#323): no tracking, nothing collected (no backend, ADR 0001).
  Required-reason APIs: only those of a binary in the app that ships no manifest of its own. Checked on the built
  Runner.app with `nm -u` (2026-11-15): sqlcipher.framework (the sqlite3 package's native asset, `source: sqlcipher`)
  imports stat/fstat/lstat and statfs/fstatfs and has no manifest, so they are declared here. Flutter.framework,
  llama.framework, LiteRtLm.framework and the plugins' bundles (UserDefaults: workmanager_apple,
  flutter_local_notifications) declare their own; the Runner's Swift code uses none.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- SQLite reads the size and metadata of the database, journal and WAL files in the app container. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- SQLite's statfs/fstatfs on the database's volume, before writing to it; nothing leaves the device. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
